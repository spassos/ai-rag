# Copie para .env e ajuste. O .env NÃO é versionado.

# Provedor de LLM/embeddings: fake (offline) | vertex | claude
LUPA_PROVIDER=fake

# Diretório de trabalho do LightRAG (índices file-based)
LUPA_WORKING_DIR=.lupa/rag

# API do Portal da Transparência (necessária só para ingestão online; o smoke
# test offline usa fixtures e NÃO precisa desta chave).
TRANSPARENCIA_API_KEY=
TRANSPARENCIA_BASE_URL=https://api.portaldatransparencia.gov.br/api-de-dados
